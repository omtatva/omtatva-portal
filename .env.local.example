# Local-only override so `npm run dev` talks to a SEPARATE Firebase
# project (its own database) instead of the real/live one — so testing
# on localhost never changes what's on the live site.
#
# How to use:
# 1. Create a new project at https://console.firebase.google.com
#    (free tier is enough). Enable: Authentication -> Google sign-in,
#    Firestore Database, and Storage — same as the real project.
# 2. In that new project: Project Settings -> General -> "Your apps" ->
#    add a Web app -> copy the config values it shows you.
# 3. Copy this file to ".env.local" (same folder) and paste those values
#    in below. .env.local is gitignored — it never gets committed or
#    deployed, it only affects your own `npm run dev`.
# 4. Restart `npm run dev` for it to take effect.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maintenance mode (see proxy.ts) — server-only, deliberately NOT
# prefixed NEXT_PUBLIC_ so it's never bundled into client JS. Set to
# "true" to test the maintenance page locally with `npm run dev`; the
# live site's real value is set separately in apphosting.yaml /
# Firebase Console for App Hosting, not here.
MAINTENANCE_MODE=true

# Optional: lets you bypass maintenance mode locally by visiting
# http://localhost:3000/dashboard?bypass=<this value>. Leave blank to
# disable the bypass.
MAINTENANCE_BYPASS_TOKEN=
