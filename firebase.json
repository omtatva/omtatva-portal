{
  "apphosting": [
    {
      "backendId": "omtatva-backend",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "bucket": "omtatva-portal.firebasestorage.app",
    "rules": "storage.rules"
  }
}
